//==============================================================================
// Hieroglyph Phonogram Engine v0.4 — FULLY CORRECTED
// All bugs from v0.3 fixed:
// 1. Co-articulation streams end-to-end (no event/stream mismatch)
// 2. First-note snap handled via transitionMs=0 (no direct bank writes)
// 3. Voice allocator uses -1 as free slot sentinel (note 0 is valid MIDI)
//==============================================================================

namespace hieroglyph
{
